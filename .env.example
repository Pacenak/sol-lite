# Copy to `.env` in the repository root. Bootstrap loads it on startup (python-dotenv).
# Most product settings live in `config/*.yaml` or per-user settings outside the repo
# (see docs/architecture/configuration.md). Only variables listed here are read from
# the environment unless noted as CI-only or voice-endpoint keys.

# --- Core runtime paths (override config/sol-lite.yaml) ---
# Disposable battle workspace or a fixed project checkout:
SOL_WORKSPACE_ROOT=./workspace
# Local memory, state, pending skills, voice.json, procedure state:
SOL_DATA_ROOT=./data

# --- Ollama (overrides config/models.yaml provider.endpoint) ---
SOL_OLLAMA_URL=http://127.0.0.1:11434
# Model names and profiles: edit config/models.yaml or user settings — not env vars.

# --- Private web search (overrides config/searxng.yaml) ---
SOL_SEARXNG_URL=
SOL_SEARXNG_ENABLED=false

# --- Optional SOL-Command pairing (secrets stay in the OS keyring) ---
# Host only; must match the URL stored at pair time. Do not set instance id/key in .env.
# SOL_COMMAND_URL=https://sol-command.corp.pacenlife.com

# --- Integration CLI helpers (tokens end up in the keyring after connect) ---
# Path to Google OAuth Desktop client JSON for `sol-lite google-connect`:
# SOL_GOOGLE_OAUTH_CLIENT_SECRETS=C:\secrets\google-oauth-client.json
# Atlassian API token for non-interactive `sol-lite jira-connect`:
# SOL_JIRA_API_TOKEN=

# --- Per-user settings file (overrides default AppData / Application Support path) ---
# SOL_LITE_SETTINGS_FILE=C:\Users\you\AppData\Roaming\SOL-Lite\settings.yaml

# --- Studio manual placeholders (runtime fills {{NAME}} in approved commands) ---
# Names must match the manual. Prefer the OS keyring (provider plg-studio); env is fallback.
# STEAM_TOKEN=
# Any other {{UPPER_SNAKE}} token your checklist references.

# --- Voice (optional hosted STT/TTS endpoints in data/state/voice.json) ---
# Each endpoint may set api_key_env to a variable name; set that name here when used:
# SOL_VOICE_OPENAI_KEY=

# --- Hugging Face cache for local faster-whisper downloads (voice probe may set HF_HOME) ---
# HF_HOME=./data/cache/huggingface

# --- Developer / CI only ---
SOL_RUN_OLLAMA_TESTS=0
# SOL_REQUIRE_ARTIFACT_RENDERERS=1
# SOL_ARTIFACT_ACCEPTANCE_OUTPUT=./artifact-acceptance-out
