SOL_LITE_ENV=development
SOL_OLLAMA_URL=http://127.0.0.1:11434
SOL_FAST_MODEL=qwen3.5:9b
SOL_ENGINEER_MODEL=qwen3-coder:30b
SOL_REVIEWER_MODEL=qwen3.5:27b
SOL_EMBEDDING_MODEL=nomic-embed-text:latest
SOL_LOG_LEVEL=INFO
SOL_REQUIRE_APPROVAL_FOR_WRITES=true
SOL_REQUIRE_APPROVAL_FOR_SHELL=true
SOL_WORKSPACE_ROOT=./workspace
SOL_DATA_ROOT=./data
OLLAMA_HEARTBEAT_INTERVAL_SECONDS=10
OLLAMA_SLOW_THRESHOLD_SECONDS=60
OLLAMA_STALL_THRESHOLD_SECONDS=180
OLLAMA_REPEAT_TOOL_THRESHOLD=3
OLLAMA_MAX_TOOL_ROUNDS=40
SOL_RUN_OLLAMA_TESTS=0

# Optional private SearXNG integration
SOL_SEARXNG_URL=
SOL_SEARXNG_ENABLED=false
