{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Infrastructure Automation tool contracts",
  "description": "Design contract only. Gateway validates the selected tool input; broker enforces semantics and approvals. No credentials, approval tokens, arbitrary argv or shell text.",
  "$defs": {
    "check_system_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "machine_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "identity",
              "interfaces",
              "routes",
              "dns",
              "listeners",
              "capacity"
            ]
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "default": 30
        }
      },
      "required": [
        "machine_id",
        "checks"
      ]
    },
    "execute_remote_command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "machine_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "operation": {
          "enum": [
            "identity",
            "interfaces",
            "routes",
            "dns",
            "listeners",
            "capacity",
            "service_state",
            "package_version",
            "config_metadata",
            "network_service_state"
          ]
        },
        "resource_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "default": 30
        }
      },
      "required": [
        "machine_id",
        "operation"
      ]
    },
    "prepare_configuration_plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "machine_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "resource_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "change": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "dns"
                },
                "servers": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "maxLength": 45,
                    "description": "Broker must parse as IPv4/IPv6 literal; no hostnames or shell text."
                  }
                }
              },
              "required": [
                "kind",
                "servers"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "static_ipv4"
                },
                "address": {
                  "type": "string",
                  "format": "ipv4"
                },
                "prefix_length": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32
                },
                "gateway": {
                  "type": "string",
                  "format": "ipv4"
                }
              },
              "required": [
                "kind",
                "address",
                "prefix_length",
                "gateway"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "dhcp_ipv4"
                }
              },
              "required": [
                "kind"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "managed_configuration"
                },
                "desired_state_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{2,63}$"
                }
              },
              "required": [
                "kind",
                "desired_state_id"
              ]
            }
          ]
        }
      },
      "required": [
        "machine_id",
        "resource_id",
        "change"
      ]
    },
    "apply_configuration_plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "machine_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        }
      },
      "required": [
        "machine_id",
        "plan_id"
      ]
    },
    "tool_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "machine_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "status": {
          "enum": [
            "OK",
            "NO_OP",
            "PLAN_READY",
            "APPROVAL_REQUIRED",
            "POLICY_DENIED",
            "PRECONDITION_FAILED",
            "UNREACHABLE",
            "HOST_IDENTITY_BLOCKED",
            "AUTH_BLOCKED",
            "UNSUPPORTED",
            "READ_FAILED",
            "OUTCOME_UNKNOWN",
            "CONTAINED",
            "VERIFICATION_FAILED",
            "ROLLED_BACK",
            "ROLLBACK_FAILED"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "summary": {
          "type": "string",
          "maxLength": 4096,
          "description": "Broker-generated sanitized summary only; never raw stdout/stderr."
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "machine_id",
        "operation_id",
        "status",
        "summary",
        "truncated"
      ]
    }
  }
}
