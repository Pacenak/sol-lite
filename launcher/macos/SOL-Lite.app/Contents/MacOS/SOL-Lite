#!/bin/zsh
set -u

APP_BUNDLE="${0:A:h:h:h}"
ROOT_FILE="$APP_BUNDLE/Contents/Resources/install-root.txt"

if [[ ! -f "$ROOT_FILE" ]]; then
    osascript -e \
        'tell application "Terminal" to do script "echo '\''SOL-Lite install root is missing. Run scripts/setup.command from the source tree.'\''"'

    exit 1
fi

ROOT="$(<"$ROOT_FILE")"
PYTHON="$ROOT/.venv/bin/python"

if [[ ! -x "$PYTHON" ]]; then
    osascript -e \
        "tell application \"Terminal\" to do script \"echo 'SOL-Lite Python environment is missing: $PYTHON'; echo 'Run scripts/setup.command from the source tree.'\""

    exit 1
fi

osascript -e \
    "tell application \"Terminal\" to do script \"cd '$ROOT' && '$PYTHON' scripts/preflight.py && '$PYTHON' -m sol_lite start\""